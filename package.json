{
  "name": "dsh-edit-question",
  "version": "0.1.1",
  "description": "编辑已发送的提问并重新发送：图片一并重发，从该提问重新开始，丢弃其后的全部对话记录。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "edit-message",
    "conversation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Akiccat/dsh-edit-question"
  },
  "bugs": {
    "url": "https://github.com/Akiccat/dsh-edit-question/issues"
  },
  "homepage": "https://github.com/Akiccat/dsh-edit-question#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "meta": {
    "title": "编辑提问并重发",
    "description": "修改已发送的提问（图片一并重发）并从该提问重新开始：其后的对话不再进入上下文，可选保留或归档原会话。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-store": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "license": "MIT"
}
